import sys
import os
import json
import socket

def send_hypr(cmd_str):
    try:
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not sig:
            hypr_dir = f"/run/user/{os.getuid()}/hypr"
            if not os.path.exists(hypr_dir):
                return None
            sigs = sorted(
                [s for s in os.listdir(hypr_dir) if os.path.isdir(os.path.join(hypr_dir, s))],
                key=lambda s: os.path.getmtime(os.path.join(hypr_dir, s)),
                reverse=True
            )
            if not sigs:
                return None
            sig = sigs[0]
        sock_path = f"/run/user/{os.getuid()}/hypr/{sig}/.socket.sock"
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(sock_path)
        payload = cmd_str.encode() if isinstance(cmd_str, str) else cmd_str
        s.sendall(payload)
        res = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            res += chunk
            if len(chunk) < 4096:
                break
        s.close()
        return res.decode()
    except Exception:
        return None

def get_state():
    state_file = os.path.expanduser("~/.config/minimo-os/state.json")
    try:
        with open(state_file, "r") as f:
            return json.load(f)
    except Exception:
        return {}

def get_monitors():
    raw = send_hypr("j/monitors")
    if not raw:
        return []
    try:
        return json.loads(raw)
    except Exception:
        return []

def get_sorted_monitors(monitors, state):
    primary_name = state.get("primaryMonitor")
    active_mons = [m for m in monitors if not m.get("disabled")]
    def sort_key(m):
        name = m.get("name", "")
        is_primary = (name == primary_name) if primary_name else (m.get("x", 0) == 0 and m.get("y", 0) == 0)
        return (0 if is_primary else 1, m.get("x", 0), m.get("y", 0))
    return sorted(active_mons, key=sort_key)

def main():
    if len(sys.argv) < 2:
        return

    action = sys.argv[1]
    param = sys.argv[2] if len(sys.argv) > 2 else None

    state = get_state()
    split = state.get("splitWorkspaces", True)

    monitors = get_monitors()
    sorted_mons = get_sorted_monitors(monitors, state)

    # Identificar o monitor focado pelo nome
    focused_name = None
    ws_raw = send_hypr("j/activeworkspace")
    ws_data = {}
    if ws_raw:
        try:
            ws_data = json.loads(ws_raw)
            focused_name = ws_data.get("monitor")
        except Exception:
            pass

    if not focused_name:
        for m in monitors:
            if m.get("focused"):
                focused_name = m.get("name")
                break

    # Índice lógico do monitor (0 = Monitor 1/Principal, 1 = Monitor 2/Secundário, ...)
    logical_index = 0
    if focused_name and sorted_mons:
        for idx, m in enumerate(sorted_mons):
            if m.get("name") == focused_name:
                logical_index = idx
                break

    cur_id = ws_data.get("id", 1)
    offset = (logical_index * 10) if split else 0

    if action == "focus" and param:
        num = int(param)
        target = offset + num
        send_hypr(f'dispatch hl.dsp.focus({{ workspace = "{target}" }})')
    elif action == "move" and param:
        num = int(param)
        target = offset + num
        send_hypr(f'dispatch hl.dsp.window.move({{ workspace = "{target}" }})')
    elif action == "next":
        if split:
            base = offset + 1
            max_ws = offset + 9
            target = cur_id + 1 if cur_id < max_ws else base
        else:
            target = cur_id + 1
        send_hypr(f'dispatch hl.dsp.focus({{ workspace = "{target}" }})')
    elif action == "prev":
        if split:
            base = offset + 1
            max_ws = offset + 9
            target = cur_id - 1 if cur_id > base else max_ws
        else:
            target = max(1, cur_id - 1)
        send_hypr(f'dispatch hl.dsp.focus({{ workspace = "{target}" }})')
    elif action == "move-next":
        if split:
            base = offset + 1
            max_ws = offset + 9
            target = cur_id + 1 if cur_id < max_ws else base
        else:
            target = cur_id + 1
        send_hypr(f'dispatch hl.dsp.window.move({{ workspace = "{target}" }})')
    elif action == "move-prev":
        if split:
            base = offset + 1
            max_ws = offset + 9
            target = cur_id - 1 if cur_id > base else max_ws
        else:
            target = max(1, cur_id - 1)
        send_hypr(f'dispatch hl.dsp.window.move({{ workspace = "{target}" }})')

if __name__ == "__main__":
    main()
