# Ghostty — Minimo OS
# Branco, limpo, sem distrações. Instalado por install.sh.
font-family = "Adwaita Mono"
font-size = 12
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-decoration = false
gtk-titlebar = false
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
confirm-close-surface = false
copy-on-select = clipboard
shell-integration-features = no-cursor
background-opacity = 0.97

# Paleta Minimo: preto e branco, cinzas suaves, destaques sóbrios
background = #ffffff
foreground = #1d1d1f
cursor-color = #1d1d1f
selection-background = #e8e8ed
selection-foreground = #1d1d1f
palette = 0=#1d1d1f
palette = 1=#d70015
palette = 2=#248a3d
palette = 3=#b25000
palette = 4=#0040dd
palette = 5=#8944ab
palette = 6=#0071a4
palette = 7=#8e8e93
palette = 8=#6e6e73
palette = 9=#ff3b30
palette = 10=#34c759
palette = 11=#ff9500
palette = 12=#007aff
palette = 13=#af52de
palette = 14=#32ade6
palette = 15=#f5f5f7
