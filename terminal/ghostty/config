# Ghostty — Minimo OS
# Branco, limpo, sem distrações. Instalado por install.sh.
font-family = "Adwaita Mono"
font-size = 12
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-decoration = false
gtk-titlebar = false
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = false
confirm-close-surface = false
copy-on-select = clipboard
shell-integration-features = no-cursor
background-opacity = 0.97

# Tema sincronizado com a aparência do Minimo OS (Claro / Escuro)
theme = dark:minimo-dark,light:minimo-light
